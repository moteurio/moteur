{
    "name": "@moteurio/astro",
    "version": "2026.10.31",
    "description": "Moteur for Astro: content loaders, typed blocks and templates, pictures, rich text and preview",
    "keywords": [
        "moteur",
        "cms",
        "headless",
        "astro",
        "withastro",
        "astro-loader",
        "astro-integration",
        "astro-component"
    ],
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./loaders": {
            "types": "./dist/loaders.d.ts",
            "import": "./dist/loaders.js"
        },
        "./integration": {
            "types": "./dist/images.d.ts",
            "import": "./dist/images.js"
        },
        "./Blocks.astro": "./src/Blocks.astro",
        "./MoteurImage.astro": "./src/MoteurImage.astro",
        "./RichText.astro": "./src/RichText.astro"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run",
        "prepublishOnly": "pnpm run build"
    },
    "peerDependencies": {
        "@moteurio/client": "^2026.10.28",
        "astro": ">=7.4"
    },
    "devDependencies": {
        "@moteurio/client": "workspace:*",
        "astro": "7.4.2",
        "vitest": "^5.0.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/moteurio/moteur.git",
        "directory": "packages/astro"
    }
}
