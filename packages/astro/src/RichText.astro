---
/**
 * Renders a rich-text field as HTML.
 *
 *     import RichText from '@moteurio/astro/RichText.astro';
 *     <RichText value={data.content} />
 *
 * It renders paragraphs, headings, lists, quotes, code and links as they were written in the CMS.
 * Text is escaped, and links that would run code are dropped. To style the output, wrap it in an
 * element such as `<div class="prose">`.
 */
import { richTextHtml } from '@moteurio/client';

interface Props {
  /** The field's value in a single language, in the form `{ dast }`. */
  value: unknown;
}

const html = richTextHtml(Astro.props.value);
---

<Fragment set:html={html} />
