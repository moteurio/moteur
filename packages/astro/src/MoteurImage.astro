---
/**
 * Renders a Moteur image as a responsive `<picture>` with every size the page may need. No sizes
 * have to be computed by the caller.
 *
 *     import MoteurImage from '@moteurio/astro/MoteurImage.astro';
 *     <MoteurImage image={page.fields.cover} sizes="(min-width: 60rem) 50vw, 100vw" />
 *
 * The `<picture>` lists AVIF first and uses WebP in the `<img>`, each with a `srcset` that is never
 * wider than the original. The field's crop is kept, and the focal point is set as the
 * `object-position`, so CSS `object-fit: cover` also crops around it. `alt` is the field's text,
 * or the asset's text if the field has none, in the page's language. It is empty when neither exists.
 *
 * The `from` option sets where the files come from:
 * - `site` is the default for pages that are built ahead of time. The build downloads each
 *   picture once, with its crop, and Astro writes every size into the site. Visitors never contact
 *   Moteur, and the next build reuses Astro's cache. This requires the `moteur()` integration or
 *   Moteur's host in `image.domains`. Without either, the picture is served by Moteur and the build logs a warning.
 * - `moteur` is the default for pages rendered on request, such as `/preview`. Moteur generates
 *   each size on its first request and caches it permanently.
 */
import type { HTMLAttributes } from 'astro/types';
import { getImage } from 'astro:assets';
import {
  imageAttributes,
  imageSrcset,
  imageUrl,
  focalPosition,
  IMAGE_WIDTHS,
  type ImageFormat,
  type ImageRatio,
  type ImageSource,
} from '@moteurio/client';
import { originalOf, warnNotAllowed } from '@moteurio/astro/integration';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> {
  /** A media field's value, read with `resolveAssets` as the loaders do, or an asset. */
  image: ImageSource;
  /** The width at which the picture is displayed, as in `<img sizes>`. Defaults to `100vw`. */
  sizes?: string;
  /** Crops the picture to this aspect ratio around the focal point. Defaults to the field's own crop, if it has one. */
  ratio?: ImageRatio;
  /** The widths to offer. Defaults to every width the server generates. */
  widths?: readonly number[];
  /** The formats in order from best to most widely supported. The last one is used for the `<img>`. Defaults to avif and webp. */
  formats?: ImageFormat[];
  /** Marks the image the page shows first, so it is loaded immediately instead of lazily. */
  priority?: boolean;
  /** The language of `alt` when the text exists in several languages. Defaults to the page's language, `Astro.currentLocale`. */
  locale?: string;
  /** Where the files come from: written into the site at build time, or served by Moteur (see above). */
  from?: 'site' | 'moteur';
}

const {
  image,
  sizes = '100vw',
  ratio,
  widths,
  formats = ['avif', 'webp'],
  priority = false,
  locale = Astro.currentLocale,
  alt,
  style,
  from = Astro.isPrerendered ? 'site' : 'moteur',
  ...rest
} = Astro.props;

const fallback = formats[formats.length - 1];
const fallbackWidth = widths?.length ? Math.max(...widths) : undefined;
const { alt: altText, ...img } = imageAttributes(image, {
  sizes,
  ratio,
  widths,
  format: fallback,
  locale,
  ...(fallbackWidth && { fallbackWidth }),
});
let sources = formats.slice(0, -1).map((format) => ({
  type: `image/${format === 'jpg' ? 'jpeg' : format}`,
  srcset: imageSrcset(image, { ratio, widths, format }),
}));

if (from === 'site' && img.src && img.width && img.height) {
  // Download each picture once at full size, either as uploaded or as Moteur's crop of it.
  // The download is lossless, so the build's encoding is the only lossy step.
  const { width, height } = img;
  const original =
    ratio || (image as { cropUrl?: string }).cropUrl
      ? imageUrl(image, width, { ratio, format: 'png' })
      : originalOf(image);
  const fallbackAt = Math.min(fallbackWidth ?? 1024, width);
  const built = original
    ? await Promise.all(
        formats.map((format) =>
          getImage({
            src: original,
            width: fallbackAt,
            height: Math.round((fallbackAt * height) / width),
            widths: [...(widths ?? IMAGE_WIDTHS)].filter((w) => w <= width),
            format,
            sizes,
          }),
        ),
      )
    : [];
  // Astro returns the URL unchanged when the host is not allowed, so fall back to Moteur's own sizes.
  if (built.length && built[0].src !== original) {
    const last = built[built.length - 1];
    img.src = last.src;
    img.srcset = last.srcSet.attribute;
    sources = sources.map((s, i) => ({ type: s.type, srcset: built[i].srcSet.attribute }));
  } else if (original) warnNotAllowed(original);
}
const position = `object-position:${focalPosition(image)}`;
---

{
  img.src && (
    <picture>
      {sources.map((s) => s.srcset && <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
      <img
        {...img}
        alt={alt ?? altText}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
        style={typeof style === 'object' && style ? { objectPosition: focalPosition(image), ...style } : [position, style].filter(Boolean).join(';')}
        {...rest}
      />
    </picture>
  )
}
