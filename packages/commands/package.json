{
    "name": "@moteurio/commands",
    "version": "2026.10.23-2",
    "description": "Everything the Moteur API can do, as declared commands: shared by the moteur CLI and the MCP server",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -b",
        "clean": "rimraf dist",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "prepublishOnly": "pnpm run build",
        "test": "vitest run",
        "coverage": "node scripts/coverage.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/moteurio/moteur.git",
        "directory": "packages/commands"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@moteurio/client": "workspace:*",
        "@moteurio/types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "license": "MIT"
}
