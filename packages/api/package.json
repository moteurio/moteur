{
    "name": "@moteurio/api",
    "version": "2026.10.24",
    "description": "Express REST API for Moteur: admin, public collections, OpenAPI, webhooks",
    "main": "./dist/index.js",
    "bin": {
        "moteur-operators": "./dist/operator/cli.js"
    },
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./*": "./dist/*"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/moteurio/moteur.git",
        "directory": "packages/api"
    },
    "homepage": "https://github.com/moteurio/moteur/tree/main/packages/api#readme",
    "bugs": {
        "url": "https://github.com/moteurio/moteur/issues"
    },
    "keywords": [
        "moteur",
        "cms",
        "headless",
        "rest",
        "openapi",
        "content-engine"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "rimraf dist",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "test": "node scripts/check-no-plugin-import-leaks.mjs && vitest run",
        "prepublishOnly": "pnpm run test && pnpm run build",
        "openapi:export": "tsx scripts/export-openapi.ts",
        "openapi:check-responses": "tsx scripts/check-openapi-responses.ts"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@moteurio/client": "workspace:*",
        "@moteurio/core": "workspace:*",
        "@moteurio/mcp": "workspace:*",
        "@moteurio/plugin-sdk": "workspace:*",
        "@moteurio/types": "workspace:*",
        "@scalar/express-api-reference": "^0.10.29",
        "axios": "^1.20.0",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "openapi-types": "^12.1.3",
        "qrcode": "^1.5.4",
        "zod": "^4.6.7"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@vitest/coverage-v8": "5.0.4",
        "tsx": "^4.23.15"
    }
}
