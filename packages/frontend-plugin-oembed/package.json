{
    "name": "@moteurio/frontend-plugin-oembed",
    "version": "2026.10.31",
    "description": "Embed blocks from Moteur on your site: the frame built from what the engine resolved, no call from the page",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./element": {
            "types": "./dist/element.d.ts",
            "import": "./dist/element.js"
        }
    },
    "sideEffects": [
        "./dist/element.js"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run",
        "prepublishOnly": "pnpm run build"
    },
    "devDependencies": {
        "jsdom": "^30.1.2",
        "vitest": "^5.0.4"
    },
    "keywords": [
        "moteur",
        "oembed",
        "web-component",
        "headless-cms"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/moteurio/moteur.git",
        "directory": "packages/frontend-plugin-oembed"
    }
}
