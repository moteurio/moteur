{
    "name": "moteur",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm -r build && tsc -b",
        "build:watch": "pnpm -r build && tsc -b --watch",
        "check:all": "pnpm lint && pnpm build && pnpm test",
        "clean": "rimraf dist && rimraf --glob \"packages/*/dist\" \"packages/*/tsconfig.tsbuildinfo\"",
        "cli": "node node_modules/@moteurio/cli/dist/index.js",
        "cli:dev": "pnpm --filter @moteurio/cli run build && node packages/cli/dist/index.js",
        "seed": "pnpm run cli -- seed",
        "seed:force": "pnpm run cli -- seed --force",
        "server": "node dist/src/api.js",
        "server:dev": "tsx --tsconfig tsconfig.server-dev.json packages/api/src/index.ts",
        "test": "pnpm -r run test",
        "test:watch": "pnpm -r run test -- --watch",
        "test:ui": "vitest --ui",
        "lint": "pnpm -r lint && eslint . --ext .ts",
        "lint:fix": "pnpm -r lint:fix && eslint . --ext .ts",
        "usage:recalc": "tsx packages/api/scripts/recalculate-usage.ts",
        "openapi:export": "pnpm --filter @moteurio/api run openapi:export",
        "openapi:check": "pnpm --filter @moteurio/api run openapi:check-responses",
        "prepare": "husky",
        "demo:build": "pnpm --filter @moteurio/demo run build:demo",
        "setup:journal-vanilla": "bash scripts/setup-journal-vanilla.sh"
    },
    "dependencies": {
        "@moteurio/api": "workspace:*",
        "@moteurio/cli": "workspace:*",
        "@moteurio/client": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/node": "^26.6.5",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitest/ui": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
